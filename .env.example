# Streaming Live RAG — Environment Configuration Template
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.
#
# All settings use the SLRAG_ prefix (from pydantic-settings env_prefix).

# =============================================================================
# STT (Speech-to-Text) Input Layer
# =============================================================================

# Input mode:
#   mock  → Deterministic benchmark replay. No API key required. (DEFAULT)
#   stt   → Real microphone + STT API. Requires STT_API_KEY.
SLRAG_INPUT_MODE=mock

# STT provider to use when INPUT_MODE=stt.
# Supported: assemblyai
SLRAG_STT_PROVIDER=assemblyai

# API key for the selected STT provider.
# For AssemblyAI: get your key at https://www.assemblyai.com/
# KEEP THIS SERVER-SIDE ONLY — never expose to the browser.
SLRAG_STT_API_KEY=

# Custom STT endpoint URL (leave blank to use provider default).
# AssemblyAI default: wss://api.assemblyai.com/v2/realtime/ws
SLRAG_STT_ENDPOINT=

# STT model identifier (provider-specific).
# AssemblyAI examples: nano, best (leave blank for provider default)
SLRAG_STT_MODEL=

# BCP-47 language code for transcription.
# Examples: en, en-IN, hi, fr
SLRAG_STT_LANGUAGE=en

# Mock provider replay delay in milliseconds (0 = synchronous for tests).
SLRAG_STT_MOCK_REPLAY_DELAY_MS=100.0

# =============================================================================
# Corpus & Retrieval (existing settings — do not remove)
# =============================================================================

# Set to true to enforce no external web requests (required for Samsung corpus isolation).
SLRAG_CORPUS_ISOLATION=true
